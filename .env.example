NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo servidor: la usa el proceso de sync para leer credenciales y escribir
# cotizaciones (saltea RLS). Supabase Dashboard > Project Settings > API keys.
SUPABASE_SECRET_KEY=
# Lo generas vos (cualquier string largo al azar) y lo cargas como variable de
# entorno del proyecto en Vercel: Vercel lo manda en el header Authorization de
# cada corrida del cron. En local poné cualquier string.
CRON_SECRET=
